sign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_201h49201h49201h.png?v=1763505369\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/dice-hoodie-slate-blue\" %}\n    {% when 2 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_9l8mtg9l8mtg9l8m.png?v=1763505369\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/creating-hoodie-pale-violet\" %}\n    {% when 3 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_6og4ml6og4ml6og4.png?v=1763505369\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/triple-world-crewneck\" %}\n    {% when 4 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_t9is69t9is69t9is.png?v=1763505369\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/astro-hoodie\" %}\n    {% when 5 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_pmylhppmylhppmyl.png?v=1763505369\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/italic-embroidered-crewneck-faded-lilac\" %}\n    {% when 6 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_ml4bzcml4bzcml4b.png?v=1763505369\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/trails-hoodie-steel-blue\" %}\n    {% when 7 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_khx3vqkhx3vqkhx3.png?v=1763505369\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/hands-hoodie-grey\" %}\n    {% when 8 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_8hqbmu8hqbmu8hqb.png?v=1763505369\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/cult-zip-grey\" %}\n    {% when 9 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_hrigynhrigynhrig.png?v=1763505643\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/hooded-jacket-realtree\" %}\n    {% when 10 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_534zmc534zmc534z.png?v=1763505369\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/gothic-arc-hoodie-light-grey\" %}\n    {% when 11 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_3jtnwt3jtnwt3jtn_copy_2.png?v=1763508139\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\/products\/gothic-arc-hoodie-light-grey\" %}\n    {% when 12 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_eciungeciungeciu.png?v=1765159044\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\" %}\n    {% when 13 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/2Gemini_Generated_Image_sgt0n9sgt0n9sgt0.png?v=1765161592\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\" %}\n    {% when 14 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_8eabet8eabet8eab.png?v=1765218079\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\" %}\n    {% when 15 %}\n      {% assign img_src = \"https:\/\/cdn.shopify.com\/s\/files\/1\/0693\/4216\/7062\/files\/Gemini_Generated_Image_o9oe63o9oe63o9oe.png?v=1765394868\" %}\n      {% assign link_url = \"https:\/\/coldcultureworldwide.com\" %}\n  {% endcase %}\n\n  <a href=\"{{ link_url }}\" class=\"image-link\">\n    <div class=\"image-wrapper\">\n      <img src=\"{{ img_src }}\" alt=\"Image {{ i }}\">\n      <div class=\"shop-button\">SHOP THE LOOK<\/div>\n    <\/div>\n  <\/a>\n{% endfor %}\n\n  <\/div>\n<\/div>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    var container = document.querySelector('.image-container');\n    if (!container) return;\n\n    \/\/ Proper Fisher–Yates shuffle of the children\n    var items = Array.from(container.children);\n    for (var i = items.length - 1; i > 0; i--) {\n        var j = Math.floor(Math.random() * (i + 1));\n        var temp = items[i];\n        items[i] = items[j];\n        items[j] = temp;\n    }\n    items.forEach(function(item) {\n        container.appendChild(item);\n    });\n\n    let isDown = false;\n    let startX;\n    let scrollLeft;\n\n    container.addEventListener('mousedown', function(e) {\n        isDown = true;\n        startX = e.pageX - container.offsetLeft;\n        scrollLeft = container.scrollLeft;\n    });\n\n    document.addEventListener('mouseup', function() {\n        isDown = false;\n    });\n\n    container.addEventListener('mousemove', function(e) {\n        if (!isDown) return;\n        e.preventDefault();\n        const x = e.pageX - container.offsetLeft;\n        const walk = (x - startX) * 3;\n        container.scrollLeft = scrollLeft - walk;\n    });\n});\n<\/script>","text_alignment":"center"}}},"order":["f6b4d4ad-5c36-457d-853e-03740823c24c","custom_liquid_pTT7ET","2c9936b0-ffc6-477f-ab9c-2c66dce0808f","featured_collections_h4mKNc","custom_liquid_GywPBE","761448ba-a4ad-4a25-9099-603153a15c50","custom_liquid_nc43gQ","custom_liquid_CRVLEG","custom_liquid_hwhnUR"]}